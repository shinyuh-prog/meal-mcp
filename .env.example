# Spoonacular Recipe API Key
SPOONACULAR_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI meal planning.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Shared Gemini Model setting (default: gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


# NutriBalance MCP (suggested adult calorie target). Server-side only.
# NUTRIBALANCE_MCP_URL: the Smithery connection endpoint for your namespace.
NUTRIBALANCE_MCP_URL="https://mcp.smithery.ai/<your-namespace>"

# SMITHERY_API_KEY: the endpoint rejects unauthenticated calls (HTTP 401) and
# expects "Authorization: Bearer <key>". Create one at smithery.ai/account/api-keys.
SMITHERY_API_KEY=""
